{
  "plugins": [
    {
      "id": "spark",
      "name": "Spark",
      "version_policy": "independent",
      "tag_prefix": "spark-v",
      "directory": "spark-plugin",
      "targets": [
        {
          "file": "spark-plugin/build.gradle.kts",
          "pattern": "(?m)^version = providers\\.gradleProperty\\(\\\"pluginVersion\\\"\\)\\.getOrElse\\(\\\"[^\\\"]+\\\"\\)$",
          "replacement": "version = providers.gradleProperty(\"pluginVersion\").getOrElse(\"{version}\")",
          "version_pattern": "(?m)^version = providers\\.gradleProperty\\(\\\"pluginVersion\\\"\\)\\.getOrElse\\(\\\"([^\\\"]+)\\\"\\)$"
        },
        {
          "file": "README.md",
          "pattern": "(spark\\-plugin\\-|SPARK_VERSION=|spark\\-v)[0-9]+\\.[0-9]+\\.[0-9]+",
          "replacement": "\\g<1>{version}",
          "version_pattern": "(?:spark\\-plugin\\-|SPARK_VERSION=|spark\\-v)([0-9]+\\.[0-9]+\\.[0-9]+)",
          "multiple": true
        },
        {
          "file": "docs/guides/JVM_INTEGRATION.md",
          "pattern": "(spark\\-plugin\\-|SPARK_VERSION=|spark\\-v)[0-9]+\\.[0-9]+\\.[0-9]+",
          "replacement": "\\g<1>{version}",
          "version_pattern": "(?:spark\\-plugin\\-|SPARK_VERSION=|spark\\-v)([0-9]+\\.[0-9]+\\.[0-9]+)",
          "multiple": true
        },
        {
          "file": "docs/guides/PLUGIN_RELEASES.md",
          "pattern": "(spark\\-plugin\\-|SPARK_VERSION=|spark\\-v)[0-9]+\\.[0-9]+\\.[0-9]+",
          "replacement": "\\g<1>{version}",
          "version_pattern": "(?:spark\\-plugin\\-|SPARK_VERSION=|spark\\-v)([0-9]+\\.[0-9]+\\.[0-9]+)",
          "multiple": true
        },
        {
          "file": "docs/specs/CLOUD_DEPLOY.md",
          "pattern": "(spark\\-plugin\\-|SPARK_VERSION=|spark\\-v)[0-9]+\\.[0-9]+\\.[0-9]+",
          "replacement": "\\g<1>{version}",
          "version_pattern": "(?:spark\\-plugin\\-|SPARK_VERSION=|spark\\-v)([0-9]+\\.[0-9]+\\.[0-9]+)",
          "multiple": true
        },
        {
          "file": "docs/specs/INTEGRATIONS.md",
          "pattern": "(spark\\-plugin\\-|SPARK_VERSION=|spark\\-v)[0-9]+\\.[0-9]+\\.[0-9]+",
          "replacement": "\\g<1>{version}",
          "version_pattern": "(?:spark\\-plugin\\-|SPARK_VERSION=|spark\\-v)([0-9]+\\.[0-9]+\\.[0-9]+)",
          "multiple": true
        },
        {
          "file": "docs/specs/JVM_PLUGINS.md",
          "pattern": "(spark\\-plugin\\-|SPARK_VERSION=|spark\\-v)[0-9]+\\.[0-9]+\\.[0-9]+",
          "replacement": "\\g<1>{version}",
          "version_pattern": "(?:spark\\-plugin\\-|SPARK_VERSION=|spark\\-v)([0-9]+\\.[0-9]+\\.[0-9]+)",
          "multiple": true
        }
      ],
      "test": [
        "gradle",
        "-p",
        "spark-plugin",
        "test",
        "--no-daemon",
        "--no-configuration-cache"
      ],
      "artifacts": [
        "spark-plugin-{version}-plugin.jar",
        "libailake_jni-linux-x86_64.so",
        "libailake_jni-macos-arm64.dylib",
        "ailake_jni-windows-x86_64.dll"
      ]
    },
